{
  "name": "revector-site",
  "version": "2.2.2",
  "private": true,
  "repository": "https://github.com/Midoelprince/revector",
  "description": "Revector: an image to vector converter that runs on your own computer.",
  "author": "Revector",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "postbuild": "node scripts/verify-output.mjs",
    "icons": "node scripts/make-icon.mjs",
    "electron:dev": "node build.mjs && electron .",
    "dist": "node build.mjs && node scripts/prepare-wincodesign.mjs && electron-builder --win --publish never",
    "publish": "node build.mjs && node scripts/prepare-wincodesign.mjs && electron-builder --win --publish always"
  },
  "revector": {
    "updateUrl": ""
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0"
  },
  "optionalDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.revector.desktop",
    "productName": "Revector",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Revector",
      "artifactName": "Revector-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Revector-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Midoelprince",
        "repo": "revector",
        "releaseType": "release"
      }
    ]
  }
}
